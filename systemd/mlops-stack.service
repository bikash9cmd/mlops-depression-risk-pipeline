# /etc/systemd/system/mlops-stack.service
#
# Lets the whole Docker Compose stack be managed like any other Linux
# service: `systemctl start|stop|restart|status mlops-stack`
#
# Install:
#   sudo cp systemd/mlops-stack.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mlops-stack

[Unit]
Description=MLOps Depression Risk Pipeline (Docker Compose stack)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/mlops-depression-risk-pipeline
ExecStart=/usr/bin/docker compose -f docker-compose.yml up -d
ExecStop=/usr/bin/docker compose -f docker-compose.yml down
ExecReload=/usr/bin/docker compose -f docker-compose.yml restart
TimeoutStartSec=180
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
